 {
  "name": "cmp0082-warn",
  "argv": [
   "-S",
   "src",
   "-B",
   "b",
   "-G",
   "Ninja"
  ],
  "files": {
   "src/CMakeLists.txt": "cmake_minimum_required(VERSION 3.13)\ncmake_policy(VERSION 3.13)\nproject(p NONE)\nset(CMAKE_POLICY_WARNING_CMP0082 ON)\nadd_subdirectory(sub)\ninstall(CODE \"message(top)\")\n",
   "src/inc.cmake": "function(f)\n  message(STATUS \"in f\")\n  get_property(s DIRECTORY PROPERTY LISTFILE_STACK)\n  message(STATUS \"stack=${s}\")\nendfunction()\nf()\n",
   "src/sub/CMakeLists.txt": "install(CODE \"message(sub)\")\n"
  }
