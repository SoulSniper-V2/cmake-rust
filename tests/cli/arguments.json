   "Ninja"
  ],
  "files": {
   "src/CMakeLists.txt": "cmake_minimum_required(VERSION 3.20)\nproject(p NONE)\nmessage(STATUS \"V=${VALID} F=${FINAL} X=${X}\")\n",
   "b/CMakeCache.txt": "// This is valid\nVALID:BOOL=TRUE\n\n// bad\n\n// One final entry\nFINAL:BOOL=TRUE\nGARBAGE LINE\nX:STRING=1\n"
  }
 },
 {
  "name": "warn-uninitialized-configure",
  "argv": [
   "-S",
   "src",
   "-B",
   "b",
   "-G",
   "Ninja",
   "--warn-uninitialized"
  ],
  "files": {
   "src/CMakeLists.txt": "cmake_minimum_required(VERSION 3.20)\nproject(p NONE)\nstring(CONFIGURE \"\\${U1} @U2@\" o)\nfile(WRITE ${CMAKE_CURRENT_BINARY_DIR}/f.in \"@U3@ ${U4}\")\nconfigure_file(${CMAKE_CURRENT_BINARY_DIR}/f.in f.out)\nconfigure_file(${CMAKE_CURRENT_BINARY_DIR}/f.in f2.out @ONLY)\n"
  }
 },
 {
  "name": "debug-output",
  "argv": [
   "-S",
   "src",
   "-B",
   "b",
   "-G",
   "Ninja",
   "--debug-output"
  ],
  "files": {
   "src/CMakeLists.txt": "cmake_minimum_required(VERSION 3.20)\nproject(p NONE)\nmessage(STATUS \"top\")\ninclude(${CMAKE_CURRENT_SOURCE_DIR}/inc.cmake)\nadd_subdirectory(sub)\nmessage(WARNING \"warn\")\nmessage(STATUS \"Configuring x\")\nfind_program(PROG_NOPE nonexistent-program-xyz)\n",
   "src/inc.cmake": "function(f)\n  message(STATUS \"in f\")\n  get_property(s DIRECTORY PROPERTY LISTFILE_STACK)\n  message(STATUS \"stack=${s}\")\nendfunction()\nf()\n",
   "src/sub/CMakeLists.txt": "message(STATUS \"sub\")\nf()\ninstall(CODE \"message(sub)\")\n"
  }
 },
