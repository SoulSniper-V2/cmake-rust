  {
    "name": "depends-color-scan",
    "argv": [
      "-E",
      "cmake_depends",
      "Unix Makefiles",
      "{work}/src",
      "{work}/src",
      "{work}/b",
      "{work}/b",
      "{work}/b/CMakeFiles/x.dir/DependInfo.cmake",
      "--color=1"
    ],
    "env": {
      "CLICOLOR_FORCE": "1",
      "VERBOSE": "1"
    },
    "files": {
      "src/main.c": "#include \"h.h\"\nint main(void) { return H; }\n",
      "src/h.h": "#define H 0\n",
      "b/CMakeFiles/x.dir/DependInfo.cmake": "set(CMAKE_DEPENDS_IN_PROJECT_ONLY OFF)\nset(CMAKE_DEPENDS_LANGUAGES\n  \"C\"\n  )\nset(CMAKE_DEPENDS_CHECK_C\n  \"{work}/src/main.c\" \"CMakeFiles/x.dir/main.c.o\"\n  )\nset(CMAKE_C_TARGET_INCLUDE_PATH\n  )\nset(CMAKE_DEPENDS_DEPENDENCY_FILES\n  )\n",
      "b/CMakeFiles/CMakeDirectoryInformation.cmake": "# CMAKE generated file: DO NOT EDIT!\nset(CMAKE_RELATIVE_PATH_TOP_SOURCE \"{work}/src\")\nset(CMAKE_RELATIVE_PATH_TOP_BINARY \"{work}/b\")\nset(CMAKE_FORCE_UNIX_PATHS 1)\nset(CMAKE_C_INCLUDE_REGEX_SCAN \"^.*$\")\nset(CMAKE_C_INCLUDE_REGEX_COMPLAIN \"^$\")\nset(CMAKE_CXX_INCLUDE_REGEX_SCAN ${CMAKE_C_INCLUDE_REGEX_SCAN})\nset(CMAKE_CXX_INCLUDE_REGEX_COMPLAIN ${CMAKE_C_INCLUDE_REGEX_COMPLAIN})\n"
    }
  },
