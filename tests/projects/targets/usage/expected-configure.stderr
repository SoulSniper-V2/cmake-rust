INCLUDE_DIRECTORIES=[<SOURCE>/public dir;$<BUILD_INTERFACE:/gen>;<SOURCE>/another-include;<SOURCE>/new-include;<SOURCE>/old-include;$<BUILD_INTERFACE:<SOURCE>>;$<BUILD_INTERFACE:<SOURCE>/.>]
INTERFACE_INCLUDE_DIRECTORIES=[<SOURCE>/public dir;$<BUILD_INTERFACE:/gen>;$<BUILD_INTERFACE:<SOURCE>>;$<BUILD_INTERFACE:<SOURCE>/.>]
INTERFACE_SYSTEM_INCLUDE_DIRECTORIES=[<SOURCE>/public dir;$<BUILD_INTERFACE:/gen>]
COMPILE_OPTIONS=[-first;-directory-first;-public]
INTERFACE_COMPILE_OPTIONS=[-public]
COMPILE_DEFINITIONS=[FOO=1;BAR]
INTERFACE_COMPILE_DEFINITIONS=[FOO=1]
COMPILE_FEATURES=[cxx_std_17]
LINK_DIRECTORIES=[<SOURCE>/relative;<SOURCE>/old-link]
LINK_OPTIONS=[-public-link;-directory-link]
LINK_LIBRARIES=[$<$<NOT:$<CONFIG:DEBUG>>:inherited>;$<$<CONFIG:DEBUG>:$<TARGET_NAME:include_only>>;-lpthread;other]
INTERFACE_LINK_LIBRARIES=[$<$<NOT:$<CONFIG:DEBUG>>:inherited>;$<LINK_ONLY:$<$<CONFIG:DEBUG>:include_only>>;$<LINK_ONLY:-lpthread>;other]
PRECOMPILE_HEADERS=[<vector>;<SOURCE>/some-header.h]
HEADER_SETS=[HEADERS;header_set]
INTERFACE_HEADER_SETS=[HEADERS;header_set]
HEADER_SET=[<SOURCE>/CMakeLists.txt]
HEADER_DIRS=[<SOURCE>]
HEADER_SET_header_set=[<SOURCE>/CMakeLists.txt]
MANUALLY_ADDED_DEPENDENCIES=[alpha;worker;zed]
SOURCES=[CMakeLists.txt]
directory definitions=[KEEP=two;-DAFTER=1]
