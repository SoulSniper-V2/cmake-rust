file(WRITE src/real.txt text)
file(CREATE_LINK real.txt src/zero SYMBOLIC)
file(CREATE_LINK zero src/one SYMBOLIC)
file(COPY src/one DESTINATION dst FOLLOW_SYMLINK_CHAIN)
file(READ_SYMLINK dst/one one)
file(READ_SYMLINK dst/zero zero)
file(READ dst/one out)
message("${one}:${zero}")
message("[${out}]")
