file(WRITE src/a.sh "test")
file(CHMOD src/a.sh PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
file(COPY src/a.sh DESTINATION source-mode)
file(COPY src/a.sh DESTINATION default-mode NO_SOURCE_PERMISSIONS)
file(COPY src/a.sh DESTINATION explicit-mode FILE_PERMISSIONS OWNER_READ OWNER_EXECUTE)
if(IS_EXECUTABLE source-mode/a.sh)
  message("Source mode retained execute")
endif()
if(NOT IS_EXECUTABLE default-mode/a.sh)
  message("Default mode cleared execute")
endif()
if(IS_EXECUTABLE explicit-mode/a.sh)
  message("Explicit mode enabled execute")
endif()
