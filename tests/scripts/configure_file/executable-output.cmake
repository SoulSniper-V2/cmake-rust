file(WRITE input "@VAR@")
file(CHMOD input PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
set(VAR "configured")
configure_file(input source-mode)
configure_file(input default-mode NO_SOURCE_PERMISSIONS)
configure_file(input explicit-mode FILE_PERMISSIONS OWNER_READ OWNER_EXECUTE)
if(IS_EXECUTABLE source-mode)
  message("Source mode retained execute")
endif()
if(NOT IS_EXECUTABLE default-mode)
  message("Default mode cleared execute")
endif()
if(IS_EXECUTABLE explicit-mode)
  message("Explicit mode enabled execute")
endif()
