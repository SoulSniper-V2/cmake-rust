string(REGEX MATCHALL "." matches "é€")
list(LENGTH matches count)
file(WRITE matches.bin "${matches}")
file(READ matches.bin matcheshex HEX)
set(items "é")
list(TRANSFORM items REPLACE "(.)(.)" "\\2\\1" OUTPUT_VARIABLE swapped)
file(WRITE swapped.bin "${swapped}")
file(READ swapped.bin swappedhex HEX)
message("count=${count}|${matcheshex}|${swappedhex}")
