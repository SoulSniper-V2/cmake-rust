string(ASCII 233 high)
file(WRITE ascii.bin "${high}")
file(READ ascii.bin asciihex HEX)
string(SUBSTRING "é" 0 1 sub)
file(WRITE sub.bin "${sub}")
file(READ sub.bin subhex HEX)
string(APPEND mixed "a" "é" "${high}" "é")
string(LENGTH "${mixed}" len)
string(FIND "${mixed}" "é" pos)
string(FIND "${mixed}" "${high}" highpos REVERSE)
message("${asciihex}|${subhex}|len=${len}|pos=${pos}|highpos=${highpos}")
