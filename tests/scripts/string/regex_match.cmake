string(REGEX MATCH "l+" a "hello")
message("a=<${a}> m0=<${CMAKE_MATCH_0}> cnt=<${CMAKE_MATCH_COUNT}>")
string(REGEX MATCH "(a)(b)(c)?" b "zabc")
message("b=<${b}> m1=<${CMAKE_MATCH_1}> m2=<${CMAKE_MATCH_2}> m3=<${CMAKE_MATCH_3}> cnt=<${CMAKE_MATCH_COUNT}>")
string(REGEX MATCH "x" c "abc")
message("c=<${c}>")
string(REGEX MATCH "^abc" d "abcabc")
message("d=<${d}>")
string(REGEX MATCH "c$" e "abc")
message("e=<${e}>")
string(REGEX MATCH "a|z" f "zzza")
message("f=<${f}>")
string(REGEX MATCH "a" g "x" "a" "y")
message("g=<${g}>")
