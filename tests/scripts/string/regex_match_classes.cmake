string(REGEX MATCH "[0-9]+" a "ab123cd")
message("a=<${a}>")
string(REGEX MATCH "[^0-9]+" b "ab123cd")
message("b=<${b}>")
string(REGEX MATCH "[a-c]+x" c "qabcx")
message("c=<${c}>")
string(REGEX MATCH "a.c" d "aXc a-c")
message("d=<${d}>")
string(REGEX MATCH "a\\.c" e "a.c aXc")
message("e=<${e}>")
