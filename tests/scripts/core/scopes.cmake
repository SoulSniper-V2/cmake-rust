set(A "hello")
set(L a b c)
message(STATUS "A=${A} L=${L}")
function(f x)
  set(R "${x}-${ARGN}" PARENT_SCOPE)
  message("in f: ${ARGC} ${ARGV} ${CMAKE_CURRENT_FUNCTION} R=[${R}]")
  set(R local)
  message("R now ${R}")
endfunction()
f(1 2 3)
message("R=${R}")
macro(m a)
  message("macro ${a} ${ARGN} ${ARGC} ${ARGV1}")
  if(a)
    message("a defined as variable")
  endif()
endmacro()
m(x y)
set(a 1)
m(x y)
foreach(i RANGE 3)
  if(i EQUAL 2)
    continue()
  endif()
  message("i=${i}")
endforeach()
message("i after=[${i}]")
foreach(a b IN ZIP_LISTS L L)
  message("${a} ${b}")
endforeach()
foreach(x IN ZIP_LISTS L L)
  message("${x_0} ${x_1}")
endforeach()
foreach(x IN LISTS L ITEMS q r)
  message("x=${x}")
endforeach()
unset(A)
message("A=[${A}]")
set(C cached CACHE STRING "doc")
set(C normal)
unset(C)
message("C=[${C}] cache=[$CACHE{C}]")
function(outer)
  function(inner)
    message("inner ${ARGV}")
  endfunction()
  inner(z)
endfunction()
outer()
inner(again)
function(message)
  _message("wrapped: ${ARGV}")
endfunction()
