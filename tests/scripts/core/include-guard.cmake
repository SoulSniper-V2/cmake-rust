# include_guard(): the VARIABLE guard is ON, DIRECTORY/GLOBAL guards are TRUE,
# and an existing guard returns without being set again.
file(WRITE g-var.cmake "include_guard()\nmath(EXPR n_var \"\${n_var}+1\")\n")
file(WRITE g-glob.cmake "include_guard(GLOBAL)\nmath(EXPR n_glob \"\${n_glob}+1\")\n")
set(n_var 0)
set(n_glob 0)
function(inner)
  include(g-var.cmake)
  get_cmake_property(vars VARIABLES)
  foreach(v IN LISTS vars)
    if(v MATCHES "^__INCGUARD_")
      message("inner guard value [${${v}}]")
    endif()
  endforeach()
  set(n_var ${n_var} PARENT_SCOPE)
endfunction()
include(g-var.cmake)
include(g-var.cmake)
inner()
include(g-glob.cmake)
include(g-glob.cmake)
get_cmake_property(vars VARIABLES)
foreach(v IN LISTS vars)
  if(v MATCHES "^__INCGUARD_")
    message("guard value [${${v}}]")
  endif()
endforeach()
get_cmake_property(props VARIABLES)
message("n_var=${n_var} n_glob=${n_glob}")
