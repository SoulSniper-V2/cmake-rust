cmake_minimum_required(VERSION 4.1)
foreach(last IN ITEMS 3 15 16 17 63)
  unset(paths)
  unset(mixed)
  foreach(i RANGE ${last})
    list(APPEND paths "dir${i}/item")
    math(EXPR key "(13 * ${i} + 1) % 5")
    if(key EQUAL 0)
      list(APPEND mixed "dir${i}/A")
    elseif(key EQUAL 1)
      list(APPEND mixed "dir${i}/a")
    else()
      list(APPEND mixed "dir${i}/${key}")
    endif()
  endforeach()
  list(SORT paths COMPARE FILE_BASENAME)
  list(SORT mixed COMPARE FILE_BASENAME CASE INSENSITIVE ORDER DESCENDING)
  message("${paths}")
  message("${mixed}")
endforeach()

# Organ-pipe keys create unbalanced partitions, exercising the heap fallback.
foreach(i RANGE 0 500)
  math(EXPR offset "${i} - 250")
  if(offset LESS 0)
    set(offset "${i}")
  else()
    math(EXPR offset "500 - ${i}")
  endif()
  math(EXPR key "1000 + ${offset} / 2")
  list(APPEND organ_pipe "dir${i}/${key}")
endforeach()
list(SORT organ_pipe COMPARE FILE_BASENAME CASE INSENSITIVE)
string(SHA256 digest "${organ_pipe}")
message("${digest}")

# NATURAL compares C strings. The suffix remains in the output even if it
# follows a NUL and does not contribute to the key.
foreach(i RANGE 0 17)
  string(JSON item GET "\"version2\\u0000${i}\"")
  list(APPEND versions "${item}")
endforeach()
list(SORT versions COMPARE NATURAL)
string(HEX "${versions}" encoded)
message("${encoded}")

# Invalid UTF-8 bytes participate in sorting as bytes.
string(ASCII 128 byte)
set(lines "é" "${byte}" "a")
list(SORT lines)
string(HEX "${lines}" encoded)
message("${encoded}")
