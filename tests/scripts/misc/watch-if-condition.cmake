macro(mark name access value)
  set(marked_${access} yes)
endmacro()
variable_watch(watched mark)
set(watched 0)
unset(marked_MODIFIED_ACCESS)
unset(marked_READ_ACCESS)
if(watched)
endif()
message("read=[${marked_READ_ACCESS}]")
variable_watch(missing_watched mark)
if(DEFINED missing_watched)
endif()
message("unknown-defined=[${marked_UNKNOWN_DEFINED_ACCESS}]")
