cmake_minimum_required(VERSION 4.1)
function(accept_second status candidate)
  message("validating ${status} ${candidate}")
  if(candidate MATCHES "/dir/")
    set(${status} FALSE PARENT_SCOPE)
  endif()
  set(SIDE_EFFECT "lost")
endfunction()
find_library(result NAMES needle HINTS data/dir data/okay VALIDATOR accept_second NO_DEFAULT_PATH)
message("picked=[${result}], cache=[$CACHE{result}]")
