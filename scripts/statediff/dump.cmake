# Deferred end-of-configure dump of interpreter state for scripts/statediff.py:
# every variable, cache entry, and each set directory, target and global
# property.  Injected with CMAKE_PROJECT_TOP_LEVEL_INCLUDES, so the project
# under test is not modified.
# _cr_props comes from the property list the harness writes.
include("${CMAKE_RUST_STATEDIFF_PROPS}")
function(_cr_dirs dir outvar)
  set(all "${dir}")
  get_property(subs DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
  foreach(s IN LISTS subs)
    _cr_dirs("${s}" sub)
    list(APPEND all ${sub})
  endforeach()
  set(${outvar} "${all}" PARENT_SCOPE)
endfunction()
function(_cr_dump)
  set(out "${CMAKE_BINARY_DIR}/statediff-dump.txt")
  file(WRITE "${out}" "")
  get_cmake_property(vars VARIABLES)
  list(SORT vars)
  foreach(v IN LISTS vars)
    if(NOT v MATCHES "^(_cr_|ARGV|ARGC|ARGN|CMAKE_CURRENT_FUNCTION|CMAKE_RUST_STATEDIFF_|__INCGUARD_)")
      file(APPEND "${out}" "VAR ${v}=[${${v}}]\n")
    endif()
  endforeach()
  get_cmake_property(cvars CACHE_VARIABLES)
  list(SORT cvars)
  foreach(v IN LISTS cvars)
    get_property(t CACHE "${v}" PROPERTY TYPE)
    get_property(a CACHE "${v}" PROPERTY ADVANCED)
    get_property(h CACHE "${v}" PROPERTY HELPSTRING)
    get_property(sv CACHE "${v}" PROPERTY STRINGS)
    file(APPEND "${out}" "CACHE ${v}:${t} adv=${a} strings=[${sv}] =[$CACHE{${v}}] help=[${h}]\n")
  endforeach()
  _cr_dirs("${CMAKE_SOURCE_DIR}" dirs)
  foreach(d IN LISTS dirs)
    foreach(p IN LISTS _cr_props)
      get_property(isset DIRECTORY "${d}" PROPERTY "${p}" SET)
      if(isset AND NOT p MATCHES "^(VARIABLES|CACHE_VARIABLES|LISTFILE_STACK|MACROS|DEFINITIONS)$")
        get_property(val DIRECTORY "${d}" PROPERTY "${p}")
        file(APPEND "${out}" "DIR ${d} ${p}=[${val}]\n")
      endif()
    endforeach()
    get_property(tgts DIRECTORY "${d}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(itgts DIRECTORY "${d}" PROPERTY IMPORTED_TARGETS)
    foreach(t IN LISTS tgts itgts)
      if(NOT TARGET "${t}")
        file(APPEND "${out}" "INVISIBLE ${d} ${t}\n")
        continue()
      endif()
      foreach(p IN LISTS _cr_props)
        get_property(isset TARGET "${t}" PROPERTY "${p}" SET)
        if(isset)
          get_property(val TARGET "${t}" PROPERTY "${p}")
          file(APPEND "${out}" "TGT ${t} ${p}=[${val}]\n")
        endif()
      endforeach()
    endforeach()
  endforeach()
  foreach(p IN LISTS _cr_props)
    get_property(isset GLOBAL PROPERTY "${p}" SET)
    if(isset)
      get_property(val GLOBAL PROPERTY "${p}")
      file(APPEND "${out}" "GLOBAL ${p}=[${val}]\n")
    endif()
  endforeach()
endfunction()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _cr_dump)
