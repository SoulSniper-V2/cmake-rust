# Generates tests/data/regex_corpus.json: (pattern, input) cases with the
# expected string(REGEX MATCH ...) group captures (CMAKE_MATCH_0..9) and
# string(REGEX MATCHALL ...) output under CMP0186 OLD and NEW, all produced
# by the reference CMake binary. Run with:
#   cmake -P scripts/gen-regex-corpus.cmake
#
# Each case runs in a separate `cmake -P` process because a compile error
# is fatal to the script; result bytes travel through files and are stored
# hex-encoded in the JSON.

set(N 0)
# Registers one (pattern, input) case. Arguments are real variables, so
# arbitrary bytes are safe inside [==[...]==] bracket arguments (everything
# except the sequence "]==]", which must not appear in a case).
function(case p i)
  set("PAT_${N}" "${p}" PARENT_SCOPE)
  set("IN_${N}" "${i}" PARENT_SCOPE)
  math(EXPR n "${N}+1")
  set(N "${n}" PARENT_SCOPE)
endfunction()

