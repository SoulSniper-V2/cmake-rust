# ----------------------------------------------------------------- driver

set(script_dir "${CMAKE_CURRENT_LIST_DIR}")
get_filename_component(out_json "${script_dir}/../tests/data/regex_corpus.json" ABSOLUTE)
set(work "${script_dir}/.regex-corpus-work")
file(REMOVE_RECURSE "${work}")
file(REMOVE_RECURSE "${out_json}")
file(MAKE_DIRECTORY "${work}")
get_filename_component(out_dir "${out_json}" DIRECTORY)
file(MAKE_DIRECTORY "${out_dir}")

# Inner script: runs one case; a regex compile error aborts with a
# non-zero exit code which the driver records as "err".
set(inner "${work}/inner.cmake")
file(WRITE "${inner}" [==[
file(READ "${W}/pat.bin" PAT)
file(READ "${W}/in.bin" IN)
string(REGEX MATCH "${PAT}" OUT "${IN}")
if(DEFINED CMAKE_MATCH_COUNT)
  file(WRITE "${W}/hit" "true")
else()
  file(WRITE "${W}/hit" "false")
endif()
foreach(g RANGE 0 9)
  if(DEFINED CMAKE_MATCH_${g})
    file(WRITE "${W}/m${g}" "${CMAKE_MATCH_${g}}")
  else()
    file(WRITE "${W}/m${g}" "")
  endif()
endforeach()
cmake_policy(SET CMP0186 OLD)
string(REGEX MATCHALL "${PAT}" MA "${IN}")
file(WRITE "${W}/mo" "${MA}")
cmake_policy(SET CMP0186 NEW)
string(REGEX MATCHALL "${PAT}" MA "${IN}")
file(WRITE "${W}/mn" "${MA}")
]==])

function(hexfile path out)
  file(READ "${path}" h HEX)
  set(${out} "${h}" PARENT_SCOPE)
endfunction()

set(json "")
math(EXPR last "${N}-1")
foreach(n RANGE 0 ${last})
  file(WRITE "${work}/pat.bin" "${PAT_${n}}")
  file(WRITE "${work}/in.bin" "${IN_${n}}")
  execute_process(
    COMMAND "${CMAKE_COMMAND}" "-DW=${work}" -P "${inner}"
    RESULT_VARIABLE rc
    OUTPUT_QUIET
    ERROR_VARIABLE cerr
  )
  hexfile("${work}/pat.bin" phex)
  hexfile("${work}/in.bin" ihex)
  if(NOT json STREQUAL "")
    string(APPEND json ",\n")
  endif()
  if(rc EQUAL 0)
    file(READ "${work}/hit" hit)
    hexfile("${work}/mo" mo)
    hexfile("${work}/mn" mn)
    set(gjson "")
    foreach(g RANGE 0 9)
      hexfile("${work}/m${g}" mh)
      if(NOT gjson STREQUAL "")
        string(APPEND gjson ",")
      endif()
      string(APPEND gjson "\"${mh}\"")
    endforeach()
    string(APPEND json
      "{\"p\":\"${phex}\",\"i\":\"${ihex}\",\"err\":false,\"hit\":${hit},\"g\":[${gjson}],\"mo\":\"${mo}\",\"mn\":\"${mn}\"}")
  else()
    if(NOT cerr MATCHES "failed to compile regex")
      message(WARNING "case ${n} failed unexpectedly: ${cerr}")
    endif()
    string(APPEND json "{\"p\":\"${phex}\",\"i\":\"${ihex}\",\"err\":true}")
  endif()
endforeach()

file(WRITE "${out_json}" "{\n\"cases\":[\n${json}\n]\n}\n")
file(REMOVE_RECURSE "${work}")
message(STATUS "wrote ${N} cases to ${out_json}")
